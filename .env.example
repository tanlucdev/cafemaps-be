# Database
# Dùng Session Pooler URL cho local (IPv4) — lấy từ Supabase > Project Settings > Database > Connection Pooling > Session mode
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?connection_limit=3&pool_timeout=20"
# DIRECT_URL — local: Session Pooler; trên Render/server IPv6: dùng direct URL
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="generate-a-strong-random-secret-here"
JWT_EXPIRES_IN="7d"

# Image storage: r2, cloudinary, or supabase
IMAGE_STORAGE_PROVIDER=r2
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_BUCKET="cafe-images"
IMAGE_MAX_OUTPUT_KB=2048
IMAGE_WEBP_MAX_QUALITY=92
IMAGE_WEBP_MIN_QUALITY=84
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_OWNER_UPLOAD_PRESET=

# Cloudflare R2: API token needs Object Read & Write for this bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL="https://images.example.com"

# Google Places API (optional)
GOOGLE_PLACES_API_KEY="your-google-api-key"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3005/api/auth/oauth/google/callback"

# OSRM route distance (optional)
# Public demo is rate-limited; production should run your own OSRM server.
OSRM_BASE_URL="https://router.project-osrm.org"
OSRM_PROFILE="driving"
OSRM_TIMEOUT_MS=2500
OSRM_MAX_DESTINATIONS=20
OSRM_MIN_INTERVAL_MS=1000
OSRM_CACHE_TTL_MS=300000
OSRM_CACHE_MAX_ENTRIES=500

# App
PORT=3005
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Resend Email — đăng ký tại resend.com, free 3000 email/tháng
RESEND_API_KEY="re_xxxxxxxxxxxx"
# Bắt buộc ở production — domain phải verified trên Resend trước khi bật gửi mail
RESEND_FROM_EMAIL="Cafe Maps <noreply@domain-da-verify.com>"
